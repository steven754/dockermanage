# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# 依赖
node_modules/
vendor/

# 构建产物
# 注意：必须用根锚定的路径。通用的 dist/ 会连 backend/internal/server/web/dist/
# 一起排除，而那个目录是 go:embed 的必需输入，缺失会导致 CI 编译失败。
/frontend/dist/
/backend/bin/
*.exe
*.dylib
*.so

# 日志与临时文件
*.log
tmp/
.cache/

# 环境与密钥（本地开发）
.env
.env.*
!.env.example
*.pem
*.key

# 运行时数据（compose 部署产生）
# 注意：用 /data/ + /compose/* 形式，才能让 !compose/.gitkeep 反选生效
/data/
/compose/*
!/compose/.gitkeep

# IDE
.idea/
.vscode/
*.swp

# Mavis 运行时产物（安全扫描批次、索引库、记忆库等）
.minimax/
